# ==========================================
# ⚡ Prometheus — minimal Railway config
# فقط ۳ متغیر زیر برای اجرای کامل کافی است. بقیه اختیاری‌اند.
# ==========================================

# --- ضروری (Required) ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
ADMIN_ID=123456789

# --- مغز AI (هر سرویس سازگار با OpenAI: OpenAI / OpenRouter / DeepSeek / Groq) ---
ROUTER_BASE_URL=https://api.openai.com/v1
ROUTER_API_KEY=sk-xxxx
ROUTER_MODEL=gpt-4o-mini

# --- اختیاری: سینک پس‌زمینه بازار (پیش‌فرض هر ۱۵ دقیقه؛ 0 = خاموش برای صرفه‌جویی KV) ---
ENABLE_FINANCIAL_SYNC=1
FINANCIAL_SYNC_INTERVAL_SEC=900

# --- اختیاری: حافظه دائمی (بدون آن ربات فقط با RAM کار می‌کند) ---
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_D1_ID=
# CLOUDFLARE_KV_ID=

# --- اختیاری: بدون کلید هم کار می‌کند (fallback رایگان داخلی) ---
# TAVILY_API_KEY=tvly-xxxx        # بدون آن: DuckDuckGo/Bing/Brave رایگان
# ALLRATESTODAY_API_KEY=           # بدون آن: TGJU + Frankfurter رایگان
# GITHUB_TOKEN=                    # بدون آن: API عمومی گیت‌هاب (ریت کمتر)
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=           # بدون آن: iTunes رایگان

# --- اختیاری: سندباکس ابری E2B (اجرای ایزوله کد در کلاد؛ بدون آن لوکال) ---
# از https://e2b.dev/dashboard?tab=keys بگیرید
# E2B_API_KEY=e2b_xxxx
# E2B_TEMPLATE=                    # خالی = تمپلیت پیش‌فرض code-interpreter
# E2B_TIMEOUT_SEC=30               # سقف اجرا ۵ تا ۱۲۰ ثانیه
