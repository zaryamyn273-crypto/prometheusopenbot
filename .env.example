# ==========================================
# ⚡ Prometheus Super-Agent Configuration
# ==========================================

# --- تنظیمات تلگرام ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ADMIN_ID=your_telegram_numeric_user_id_here

# --- کلیدهای هوش مصنوعی (OpenAI / Claude / Router) ---
ROUTER_BASE_URL=https://api.openai.com/v1
ROUTER_API_KEY=your_ai_service_api_key_here
ROUTER_MODEL=gpt-4o-mini

# --- پایگاه داده ابری کلودفلر (Cloudflare D1 & KV) ---
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_D1_ID=your_cloudflare_d1_database_uuid_here
CLOUDFLARE_KV_ID=your_cloudflare_kv_namespace_id_here

# --- سایر سرویس‌ها (اختیاری یا مورد نیاز ابزارها) ---
TINYFISH_API_KEY=your_tinyfish_api_key_here
ALLRATESTODAY_API_KEY=your_allratestoday_api_key_here
ALLRATESTODAY_URL=https://allratestoday.com/api/v1/rates
GITHUB_TOKEN=your_github_personal_access_token_here
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_API_KEYS=

# --- اسپاتیفای (اختیاری: کاور و متادیتای دقیق آهنگ؛ بدون آن از iTunes استفاده می‌شود) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
